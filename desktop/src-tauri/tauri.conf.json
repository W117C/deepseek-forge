{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Forge",
  "version": "0.4.0",
  "identifier": "dev.deepseek-forge.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:5174",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "DeepSeek Forge",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}